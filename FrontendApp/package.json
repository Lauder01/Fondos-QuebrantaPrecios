{
  "name": "frontend-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:local": "ng serve --configuration=local --proxy-config proxy.conf.json",
    "start:azure": "ng serve --configuration=azure",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --ssl --proxy-config proxy.conf.json",
    "start:staging": "ng serve --configuration=staging --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration=production",
    "build:local": "ng build --configuration=local",
    "build:azure": "ng build --configuration=azure",
    "build:staging": "ng build --configuration=staging",
    "build:vercel": "npm run setup-bootstrap-ci && ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:FrontendApp": "node dist/FrontendApp/server/server.mjs",
    "start:cert": "set NODE_EXTRA_CA_CERTS=C:\\SC25\\Fondos-QuebrantaPrecios\\FrontendApp\\Certificates\\cert.crt && npm start",
    "setup-bootstrap": "powershell -Command \"if (!(Test-Path 'src/assets/bootstrap')) { New-Item -ItemType Directory -Path 'src/assets/bootstrap' -Force } ; Invoke-WebRequest -Uri 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' -OutFile 'src/assets/bootstrap/bootstrap.min.css'\"",
    "setup-bootstrap-ci": "node -e \"const fs = require('fs'); const https = require('https'); const path = require('path'); const dir = 'src/assets/bootstrap'; if (!fs.existsSync(dir)) fs.mkdirSync(dir, {recursive: true}); const file = fs.createWriteStream(path.join(dir, 'bootstrap.min.css')); https.get('https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css', (response) => response.pipe(file));\""
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-server": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@angular/ssr": "^20.2.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^18.0.7",
    "@angular/compiler-cli": "^20.2.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.8.3"
  }
}
