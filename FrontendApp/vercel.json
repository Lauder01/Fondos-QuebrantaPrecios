{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/FrontendApp/browser",
  "installCommand": "npm install && npm run setup-bootstrap-ci",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://devdemoapi1.azurewebsites.net/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
